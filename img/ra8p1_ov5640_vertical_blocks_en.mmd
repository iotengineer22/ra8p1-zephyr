    subgraph S1["① MIPI CSI-2 Differential Clock Lane (140 MHz DDR)"]
        direction LR
        S1_R["RA8P1: MIPI_CLK_P / N<br/>(D-PHY RX Clock Input)"]
        S1_C["OV5640: TX_CLK_P / N<br/>(Diff Clock Output)"]
        S1_R ---|"◀──────────────── 140 MHz DDR Clock ────────────────"| S1_C
    end

    subgraph S2["② MIPI CSI-2 Differential Data Lane 0 (280 Mbps)"]
        direction LR
        S2_R["RA8P1: MIPI_D0_P / N<br/>(D-PHY RX Data 0 Input)"]
        S2_C["OV5640: TX_D0_P / N<br/>(Diff Data 0 Output)"]
        S2_R ---|"◀──────────────── 280 Mbps Video Packet Data ──────────"| S2_C
    end

    subgraph S3["③ MIPI CSI-2 Differential Data Lane 1 (280 Mbps)"]
        direction LR
        S3_R["RA8P1: MIPI_D1_P / N<br/>(D-PHY RX Data 1 Input)"]
        S3_C["OV5640: TX_D1_P / N<br/>(Diff Data 1 Output)"]
        S3_R ---|"◀──────────────── 280 Mbps Video Packet Data ──────────"| S3_C
    end

    subgraph S4["④ Master Reference Clock (24.0 MHz XCLK)"]
        direction LR
        S4_R["RA8P1: P501 (GTIOC12A)<br/>GPT12 Master Clock Output"]
