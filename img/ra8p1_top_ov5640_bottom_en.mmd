flowchart TD
    subgraph RA8P1["Renesas RA8P1 MCU (Host Side)"]
        direction LR
        R1["MIPI_CLK_P / N<br/>(D-PHY RX Clock)"]
        R2["MIPI_D0_P / N<br/>(D-PHY RX Data 0)"]
        R3["MIPI_D1_P / N<br/>(D-PHY RX Data 1)"]
        R4["P501 (GTIOC12A)<br/>GPT12 Timer (24MHz)"]
        R5["IIC1_SCL<br/>(I2C Clock Output)"]
        R6["IIC1_SDA<br/>(I2C Bidirectional)"]
        R7["P709 (GPIO)<br/>CAM_RESET Output"]
        R8["P108 (GPIO)<br/>MIPI_IF_EN Output"]
    end

    subgraph CAM["OmniVision OV5640 (Camera Module Side)"]
        direction LR
        C1["TX_CLK_P / N<br/>(Diff Clock Output)"]
        C2["TX_D0_P / N<br/>(Diff Data 0 Output)"]
        C3["TX_D1_P / N<br/>(Diff Data 1 Output)"]
        C4["XVCLK / XCLK<br/>(24MHz Ext Clock)"]
        C5["SIOC<br/>(SCCB Clock Input)"]
        C6["SIOD<br/>(SCCB Bidirectional)"]
        C7["RESETB<br/>(Active-Low Reset)"]
        C8["On-board MIPI MUX<br/>(Camera Path Select)"]
    end

    R1 ---|"▲<br/>① 140MHz DDR<br/>Diff Clock<br/>│"| C1
    R2 ---|"▲<br/>② 280Mbps<br/>Diff Data 0<br/>│"| C2
    R3 ---|"▲<br/>③ 280Mbps<br/>Diff Data 1<br/>│"| C3
    R4 ---|"│<br/>④ 24.0MHz<br/>Master Clock (XCLK)<br/>▼"| C4
    R5 ---|"│<br/>⑤ I2C SCL<br/>Camera Clock<br/>▼"| C5
    R6 ---|"▲<br/>⑥ I2C SDA<br/>Bidirectional (0x3C)<br/>▼"| C6
    R7 ---|"│<br/>⑦ CAM_RESET<br/>Active-Low<br/>▼"| C7
    R8 ---|"│<br/>⑧ MIPI_IF_EN<br/>MUX Enable (LOW)<br/>▼"| C8

    classDef raStyle fill:#f3e5f5,stroke:#6a1b9a,stroke-width:3px,color:#4a148c;
    classDef camStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:3px,color:#0d47a1;
    classDef mipiPin fill:#fff9c4,stroke:#f57f17,stroke-width:2px,color:#bf360c;
    classDef clkPin fill:#e0f7fa,stroke:#00838f,stroke-width:1.5px,color:#006064;
    classDef i2cPin fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px,color:#1b5e20;
    classDef gpioPin fill:#fbe9e7,stroke:#d84315,stroke-width:1.5px,color:#b71c1c;

    class RA8P1 raStyle;
    class CAM camStyle;
    class R1,R2,R3,C1,C2,C3 mipiPin;
    class R4,C4 clkPin;
    class R5,R6,C5,C6 i2cPin;
    class R7,R8,C7,C8 gpioPin;
