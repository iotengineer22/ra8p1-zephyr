flowchart TD
    subgraph S1["① MIPI CSI-2 差動クロックレーン (140 MHz DDR)"]
        direction LR
        S1_R["RA8P1: MIPI_CLK_P / N<br/>(D-PHY RX クロック入力)"]
        S1_C["OV5640: TX_CLK_P / N<br/>(差動 クロック出力)"]
        S1_R ---|"◀──────────────── 140 MHz DDR クロック ────────────────"| S1_C
    end

    subgraph S2["② MIPI CSI-2 差動データレーン0 (280 Mbps)"]
        direction LR
        S2_R["RA8P1: MIPI_D0_P / N<br/>(D-PHY RX データ0入力)"]
        S2_C["OV5640: TX_D0_P / N<br/>(差動 データ0出力)"]
        S2_R ---|"◀──────────────── 280 Mbps 映像パケットデータ ──────────"| S2_C
    end

    subgraph S3["③ MIPI CSI-2 差動データレーン1 (280 Mbps)"]
        direction LR
        S3_R["RA8P1: MIPI_D1_P / N<br/>(D-PHY RX データ1入力)"]
        S3_C["OV5640: TX_D1_P / N<br/>(差動 データ1出力)"]
        S3_R ---|"◀──────────────── 280 Mbps 映像パケットデータ ──────────"| S3_C
    end

    subgraph S4["④ リファレンスクロック (24.0 MHz)"]
        direction LR
        S4_R["RA8P1: P501 (GTIOC12A)<br/>GPT12 タイマー出力"]
