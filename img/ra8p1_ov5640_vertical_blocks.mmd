        S4_R ---|"──────────────── 24.0 MHz 矩形波マスタークロック ───────▶"| S4_C
    end

    subgraph S5["⑤ I2C / SCCB クロック線"]
        direction LR
        S5_R["RA8P1: IIC1_SCL (P401相当)<br/>I2C クロック出力"]
        S5_C["OV5640: SIOC<br/>(SCCB クロック入力)"]
        S5_R ---|"──────────────── カメラレジスタ設定用クロック ──────────▶"| S5_C
    end

    subgraph S6["⑥ I2C / SCCB 双方向データ線"]
        direction LR
        S6_R["RA8P1: IIC1_SDA (P400相当)<br/>I2C 双方向データ"]
        S6_C["OV5640: SIOD<br/>(SCCB 双方向データ)"]
        S6_R ---|"◀─────────────── 双方向レジスタデータ (0x3C) ───────────▶"| S6_C
    end

    subgraph S7["⑦ ハードウェアリセット線"]
        direction LR
        S7_R["RA8P1: P709 (GPIO)<br/>CAM_RESET 出力"]
        S7_C["OV5640: RESETB<br/>(Active-Low リセット入力)"]
        S7_R ---|"──────────────── ハードウェアリセット (Lowアクティブ) ───▶"| S7_C
    end

    subgraph S8["⑧ 基板マルチプレクサ制御線"]
        direction LR
        S8_R["RA8P1: P108 (GPIO)<br/>MIPI_IF_EN 出力"]
        S8_C["基板上 MIPI MUX<br/>(カメラ側パス有効化)"]
        S8_R ---|"──────────────── マルチプレクサ切替 (Low出力でカメラ選択) ─▶"| S8_C
    end

